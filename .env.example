# Meme Studio Pro — configuración
# --------------------------------------------------------------------
# Copia este archivo a `.env` y edita los valores que quieras. Funciona
# igual para `python server.py` (local) y para `docker compose up`
# (Docker lo interpola e inyecta en el contenedor).
#
# Precedencia: variable de entorno > .env > valor por defecto.

# --- Servidor HTTP -------------------------------------------------
# Puerto publicado en el HOST (el mapeo de Docker usa esta clave).
HOST_PORT=5005
# Puerto interno al que escucha server.py localmente (Docker siempre 5005).
PORT=5005
# Dirección de escucha local. En Docker el contenedor SIEMPRE escucha en
# 0.0.0.0; cambiarla solo afecta a `python server.py`.
HOST=0.0.0.0

# --- Modelo IA (rembg) ----------------------------------------------
# Vacío -> automático: u2netp en ARM (Raspberry Pi), u2net en x86.
# Valores válidos: u2net, u2netp, isnet-general-use, birefnet-general, ...
REMBG_MODEL=

# --- API backend ----------------------------------------------------
# Orígenes CORS admitidos, separados por comas. "*" = cualquiera.
# Si sirves el backend en la LAN para la app Android, basta con * (o
# lista origen por origen).
CORS_ORIGINS=*

# --- Búsqueda de memes (Reddit via Arctic Shift) --------------------
# Subreddits donde se busca, separados por comas. Arctic Shift rechaza
# (400/422) la búsqueda por texto en subreddits MUY activos (r/memes);
# los que fallen se saltan solos.
REDDIT_SUBS=dankmemes,me_ira,wholesomememes,photoshopbattles,AdviceAnimals

# Términos usados por el botón "Reddit" sin texto (aleatorio).
REDDIT_TERMS=drake,cat,dog,anime,gaming,monday,office,sad,happy,work,school,food

# TTL del caché del catálogo/Busqueda (Imgflip y Reddit), en segundos.
MEME_CACHE_TTL=300

# Máximo de imágenes guardadas en el proxy /api/meme-image (por memoria).
IMG_CACHE_MAX=120

# --- Protecciones de /api/remove-bg (inferencia CPU) ------------------
# Tamaño máximo de imagen aceptado, en MB (más grande -> 413).
MAX_UPLOAD_MB=10
# Inferencias en paralelo (cada una usa un modelo U2-Net en CPU;
# las que excedan reciben 429 en vez de encolar y saturar la máquina).
MAX_REMOVAL_CONCURRENCY=2
# 1 = carga el modelo en un hilo al arrancar (la primera petición no
# espera la descarga inicial del modelo; el arranque consume RAM antes).
PREWARM_MODEL=0

# --- Acceso y sincronización de borradores (movil <-> PC) --------------
# Usuarios y contraseñas (Basic Auth del navegador). Separados por comas,
# formato "usuario:contrasena". Vacio = SIN login (uso local/LAN normal).
# Activalo si expones el servidor fuera de casa (Cloudflare Tunnel, etc.):
#   AUTH_USERS=daniel:mipass,novia:supass
# Con login activo, CADA usuario guarda su propio borrador en el servidor
# con los botones "Subir borrador"/"Traer borrador" de la interfaz.
AUTH_USERS=

# --- Login con cuentas (recomendado para despliegues publicos) ---------
# 1 = exige iniciar sesion para usar la API (los estaticos quedan abiertos
# para poder renderizar el formulario). Cada persona puede CREAR SU CUENTA
# desde la propia interfaz; usuarios, hashes scrypt y sesiones se guardan
# en SQLite (ver AUTH_DB). Prioridad: AUTH_USERS (Basic) > REQUIRE_LOGIN.
# Sin AUTH_USERS y sin REQUIRE_LOGIN = app abierta (LAN, como siempre).
REQUIRE_LOGIN=
# 0 = cierra el registro publico (solo pueden entrar cuentas ya creadas).
REGISTRATION_OPEN=1
# Días de vida de cada sesion (cookie HttpOnly; se renueva al entrar).
SESSION_DAYS=30
# Archivo de base de datos de cuentas. Vacio = ./data/memestudio.db.
# En Docker persistirlo como volumen (volumen `data` en docker-compose).
AUTH_DB=
# 1 = el servidor corre detras de HTTPS (Cloudflare Tunnel, proxy
# inverso...) y la cookie de sesion se marca Secure.
PUBLIC_HTTPS=

# Carpeta donde se guardan los borradores remotos por usuario.
# Vacio = ./drafts (junto a server.py). En Docker persiste como volumen.
DRAFT_DIR=

# Tamaño máximo de un borrador subido, en MB (las imágenes viajan
# incrustadas en el JSON como PNG base64).
DRAFT_MAX_MB=25

# --- Android ---------------------------------------------------------
# La app APK no lee este .env: el campo "Servidor IA" de su interfaz
# guarda en localStorage a qué PC de la LAN apuntar (http://192.168.x.x:5005).
